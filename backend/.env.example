# Copy to backend/.env and fill in. backend/.env is gitignored.

# Required: phrase generation (gpt-4o-mini) and embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Required: vector cache. The project must contain two indexes,
# "song-embeddings" and "phrase-embeddings" (dimension 1536)
PINECONE_API_KEY=

# Optional: only needed for POST /reset-pinecone (sent as the X-Admin-Key header)
ADMIN_API_KEY=

# Optional: only needed for POST /get-playlist-tracks (playlist import is disabled in the UI)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
